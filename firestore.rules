rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // User profiles matching authentication uid
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) 
        && incoming().uid == userId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().createdAt != null
        && (
          (incoming().email == "ekowirsabits@gmail.com" && incoming().role == "Admin" && incoming().approved == true) ||
          (incoming().email != "ekowirsabits@gmail.com" && incoming().role == "User" && incoming().approved == false)
        );
      allow update: if (isOwner(userId)
        && incoming().uid == userId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().createdAt == existing().createdAt
        && incoming().role == existing().role
        && incoming().approved == existing().approved)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Scholar contacts database
    match /ustadz/{ustadzId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && isValidId(ustadzId)
        && incoming().id == ustadzId
        && incoming().name is string && incoming().name.size() <= 150
        && incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isAdmin()
        && isValidId(ustadzId)
        && incoming().id == ustadzId
        && incoming().name is string && incoming().name.size() <= 150
        && incoming().phone is string && incoming().phone.size() <= 30;
      allow delete: if isAdmin() && isValidId(ustadzId);
    }

    // Report archives nested inside user profiles
    match /users/{userId}/reports/{reportId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(reportId)
        && incoming().id_hasil == reportId
        && incoming().userId == userId
        && incoming().nama_pewaris is string && incoming().nama_pewaris.size() <= 200
        && incoming().tirkah is number
        && incoming().createdAt != null;
      allow update: if false; // Faraid reports are historically immutable and cannot be altered
      allow delete: if isOwner(userId) && isValidId(reportId);
    }

    // Dynamic simulated reports for iframe sandbox fallback
    match /simulated_reports/{reportId} {
      allow get: if true;
      allow list: if resource.data.userId is string && resource.data.userId.size() <= 100;
      allow create: if isValidId(reportId)
        && incoming().id_hasil == reportId
        && incoming().userId is string && incoming().userId.size() <= 100
        && incoming().nama_pewaris is string && incoming().nama_pewaris.size() <= 200
        && incoming().tirkah is number
        && incoming().createdAt != null;
      allow update: if false; // Reports are historically immutable
      allow delete: if isValidId(reportId) && resource.data.userId is string && resource.data.userId.size() <= 100;
    }

    // Dynamic simulated users for iframe database fallback
    match /simulated_users/{userId} {
      allow get, list, create, update, delete: if true;
    }
  }
}
